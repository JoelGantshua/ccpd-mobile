
import {
    Body,
    Controller,
    Get,
    HttpCode,
    HttpException,
    HttpStatus,
    Post,
    Req,
    ServiceUnavailableException,
    UseGuards,
  } from '@nestjs/common';
  
  import { Throttle } from '@nestjs/throttler';
  
  import { AuthService } from './auth.service.js';
  import { LoginService } from './login.service.js';
  import { SessionService } from './session.service.js';
  import { JwtAccessGuard } from './jwt-access.guard.js';
  
  import { EmailVerificationService } from './email-verification.service.js';
  import { VerificationMailService } from './verification-mail.service.js';
  import { UsersService } from '../users/users.service.js';
  
  import { RegisterDto } from './dto/register.dto.js';
  import { VerifyEmailDto } from './dto/verify-email.dto.js';
  import { ResendVerificationDto } from './dto/resend-verification.dto.js';
  import { LoginDto } from './dto/login.dto.js';
  import { RefreshTokenDto } from './dto/refresh-token.dto.js';
  
  type AuthenticatedRequest = {
    user: {
      id: string;
      fullName: string;
      role: string;
      provinceId: string | null;
    };
  };
  
  @Controller('auth')
  export class AuthController {
    constructor(
      private readonly authService: AuthService,
      private readonly emailVerificationService: EmailVerificationService,
      private readonly verificationMailService: VerificationMailService,
      private readonly usersService: UsersService,
      private readonly loginService: LoginService,
      private readonly sessionService: SessionService,
    ) {}
  
    @Post('register')
    @HttpCode(HttpStatus.ACCEPTED)
    @Throttle({ default: { limit: 3, ttl: 60_000 } })
    async register(@Body() dto: RegisterDto) {
      if (!this.verificationMailService.isConfigured()) {
        throw new ServiceUnavailableException(
          'Inscription temporairement indisponible',
        );
      }
  
      const user = await this.authService.registerMember(dto);
  
      const verification =
        await this.emailVerificationService.issueToken(user.id);
  
      try {
        await this.verificationMailService.sendVerificationEmail(
          user.email,
          verification.token,
        );
      } catch {
        throw new ServiceUnavailableException(
          'Envoi de verification indisponible',
        );
      }
  
      return {
        message: 'Inscription enregistree. Verifiez votre messagerie.',
        requiresEmailVerification: true,
        requiresAdminApproval: true,
      };
    }
  
    @Post('verify-email')
    @HttpCode(HttpStatus.OK)
    @Throttle({ default: { limit: 5, ttl: 60_000 } })
    async verifyEmail(@Body() dto: VerifyEmailDto) {
      return this.emailVerificationService.consumeToken(dto.token);
    }
  
    @Post('resend-verification')
    @HttpCode(HttpStatus.ACCEPTED)
    @Throttle({ default: { limit: 3, ttl: 60_000 } })
    async resendVerification(
      @Body() dto: ResendVerificationDto,
    ) {
      if (!this.verificationMailService.isConfigured()) {
        throw new ServiceUnavailableException(
          'Service de verification indisponible',
        );
      }
  
      const response = {
        message:
          'Si ce compte necessite une verification, un e-mail pourra etre envoye.',
      };
  
      const user =
        await this.usersService.findForAuthentication(
          dto.email.trim().toLowerCase(),
        );
  
      if (!user || user.emailVerifiedAt) {
        return response;
      }
  
      let token: string;
  
      try {
        const verification =
          await this.emailVerificationService.issueToken(user.id);
  
        token = verification.token;
      } catch (error) {
        if (
          error instanceof HttpException &&
          error.getStatus() === HttpStatus.TOO_MANY_REQUESTS
        ) {
          return response;
        }
  
        throw error;
      }
  
      try {
        await this.verificationMailService.sendVerificationEmail(
          user.email,
          token,
        );
      } catch (error) {
        // Diagnostic serveur uniquement : ne pas exposer
        // les informations du compte dans la reponse HTTP.
        console.error(
          '[CCPD] Echec envoi verification SMTP',
          error instanceof Error ? error.message : 'Erreur inconnue',
        );
      }
  
      return response;
    }
  
    @Post('login')
    @HttpCode(HttpStatus.OK)
    @Throttle({ default: { limit: 5, ttl: 60_000 } })
    async login(@Body() dto: LoginDto) {
      const result = await this.loginService.login(dto);
  
      const session = await this.sessionService.createSession(
        result.user.id,
      );
  
      return {
        ...result,
        accessToken: session.accessToken,
        refreshToken: session.refreshToken,
      };
    }
  
    @Post('refresh')
    @HttpCode(HttpStatus.OK)
    @Throttle({ default: { limit: 10, ttl: 60_000 } })
    async refresh(@Body() dto: RefreshTokenDto) {
      return this.sessionService.refresh(dto.refreshToken);
    }
  
    @Post('logout')
    @HttpCode(HttpStatus.OK)
    @UseGuards(JwtAccessGuard)
    async logout(
      @Req() request: AuthenticatedRequest,
      @Body() dto: RefreshTokenDto,
    ) {
      return this.sessionService.logout(
        request.user.id,
        dto.refreshToken,
      );
    }
  
    @Post('logout-all')
    @HttpCode(HttpStatus.OK)
    @UseGuards(JwtAccessGuard)
    async logoutAll(@Req() request: AuthenticatedRequest) {
      return this.sessionService.logoutAll(request.user.id);
    }
  
    @Get('me')
    @UseGuards(JwtAccessGuard)
    async me(@Req() request: AuthenticatedRequest) {
      return request.user;
    }
  }
  
